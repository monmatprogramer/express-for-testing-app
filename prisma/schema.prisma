// use prisma-8

native_enum Role {
    ADMIN   = "ADMIN"
    TENANT  = "TENANT"
}   


model User {
    id              String          @id @onCreate(uuid())
    name            String          
    phone           String
    email           String          @unique
    passwordHash    String
    role            pg.enum(Role)   @default("TENANT")
    createdAt       TimestamptzJsDate        @default(now())                   @map("created_at")
    updatedAt       TimestamptzJsDate        @default(now()) @onUpdate(now())  @map("updated_at")
    
    sessions       Session[]
    
    @@map("users")
    @@rls
}
model Session {
    id                      String          @id     @onCreate(uuid())
    userId                  String          @map("user_id")
    currentTokenHash        String          @unique @map("current_token_hash")
    previousTokenHash       String?         @unique @map("previous_token_hash")
    expiredAt               TimestamptzJsDate        @map("expired_at")
    revokedAt               TimestamptzJsDate?       @map("revoked_at")
    ip                      String?         
    userAgent               String?         @map("user_agent")
    createdAt               TimestamptzJsDate        @default(now())     @map("created_at")
    
    user                    User            @relation(fields: [userId], references:[id], onDelete: Cascade)
    
    @@index([userId])
    @@map("sessions")
    @@rls
}

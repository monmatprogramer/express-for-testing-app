{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e",
    "name": "Express For Testing API",
    "description": "Postman collection for Express testing app featuring health checks and JWT-authenticated endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "General",
      "item": [
        {
          "name": "Root Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}",
              "host": ["{{baseUrl}}"]
            },
            "description": "Verifies that the API server is up and responsive."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "User Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/health",
              "host": ["{{baseUrl}}"],
              "path": ["users", "health"]
            },
            "description": "Checks the health status of user-related services."
          },
          "response": []
        },
        {
          "name": "User Login (Generates JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Extract and store JWT token\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string');",
                  "    pm.environment.set(\"accessToken\", response.token);",
                  "    console.log(\"Saved accessToken to environment:\", response.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 101,\n  \"username\": \"monmat\",\n  \"role\": \"admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "login"]
            },
            "description": "Authenticates user and saves JWT bearer token to the environment variable {{accessToken}}."
          },
          "response": []
        },
        {
          "name": "Get User Profile (Protected)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"User profile decoded from token\", function () {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.user).to.be.an('object');",
                  "    pm.expect(response.user.userId).to.eql(101);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "description": "Fetches the current user profile using the JWT bearer token."
          },
          "response": []
        }
      ]
    }
  ]
}

{
  "name": "express-for-testing-app",
  "version": "1.0.0",
  "description": "Express.js REST API with TypeScript and JWT authentication for testing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "postinstall": "prisma skills sync || exit 0",
    "contract:emit": "prisma contract emit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monmatprogramer/express-for-testing-app.git"
  },
  "keywords": [
    "express",
    "typescript",
    "jwt",
    "authentication",
    "rest-api",
    "nodejs"
  ],
  "author": "monmatprogramer",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.9.0",
    "@prisma/client": "^7.10.1",
    "@prisma/orm-postgres": "^8.0.0-rc.21",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/uuid": "^10.0.0",
    "prisma": "^8.0.0-rc.28",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@prisma/orm-framework": "8.0.0-rc.21",
    "@prisma/orm-toolchain": "8.0.0-rc.21"
  }
}

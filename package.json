{
  "name": "express-for-testing-app",
  "version": "1.0.0",
  "description": "Express.js REST API with TypeScript and JWT authentication for testing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monmatprogramer/express-for-testing-app.git"
  },
  "keywords": [
    "express",
    "typescript",
    "jwt",
    "authentication",
    "rest-api",
    "nodejs"
  ],
  "author": "monmatprogramer",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/composer": "0.28.0",
    "@prisma/composer-prisma-cloud": "0.28.0",
    "alchemy": "2.0.0-beta.78",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "effect": "4.0.0-rc.115",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/uuid": "^10.0.0",
    "prisma": "8.0.0-rc.21",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-mysql2": "4.0.0-rc.115",
    "@effect/sql-pg": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  }
